<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ROOT.Zfs.Tests</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OutputType>Exe</OutputType>
    <!-- Microsoft.Testing.* packages ship lower-case locale folders that .NET 10 flags as NETSDK1188. -->
    <NoWarn>$(NoWarn);NETSDK1188</NoWarn>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="ROOT.Shared.Utils.Serialization" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ROOT.Zfs.Core\ROOT.Zfs.Core.csproj" />
  </ItemGroup>
</Project>
